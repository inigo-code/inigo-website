---
layout: layouts/base.njk
title: Articles
permalink: /articles/
description: "Essays on management, work and organisations by Inigo Papu Vinodhan, followed by his published research."
pageScript: /assets/list-filter.js
---
<div class="wrap page">
  <header class="page-head">
    <p class="eyebrow">Writing</p>
    <h1>Articles</h1>
    <p class="lead">Essays on management, work and running organisations, then my published research with links to read it.</p>
    <span class="head-motif">{% include "motifs/book.svg" %}</span>
  </header>

  {#- Search and topic filter: shown only when scripts run (without them every essay is listed). Kept in ?topic= and ?q= -#}
  {% set topics = ["HR and work life", "Leadership", "For students"] %}
  <div class="section-head essays-head">
    <h2 class="sr-only">Essays</h2>
    <p class="section-note" id="essays-count" aria-live="polite">{{ collections.articles.length }} essays, newest first</p>
  </div>
  <div class="list-tools" data-list-filter data-items=".article-lead, .article-grid > li" data-param="topic" data-count="#essays-count" data-empty="#essays-empty" data-noun="essay,essays">
    <div class="chips" role="group" aria-label="Show essays by topic">
      <button type="button" class="chip" data-value="all" aria-pressed="true">All <span>{{ collections.articles.length }}</span></button>
      {% for t in topics %}{% set k = collections.articles | byTopic(t) %}<button type="button" class="chip" data-value="{{ t | slugify }}" aria-pressed="false"{% if not k.length %} disabled{% endif %}>{{ t }} <span>{{ k.length }}</span></button>{% endfor %}
    </div>
    {% set searchLabel = "Search the essays" %}{% set searchHint = "Search essays…" %}{% include "list-search.njk" %}
  </div>

  {% set lead = collections.articles | first %}
  {% if lead %}
  <article class="article-lead" data-value="{{ lead.data.topic | slugify }}" data-search="{{ lead.data.title }} {{ lead.data.description }} {{ lead.data.topic }} {{ (lead.data.keywords or []) | join(' ') }}">
    <div class="article-media">{% set d = lead.data %}{% set decor = true %}{% include "media.njk" %}</div>
    <div class="article-lead-text">
      <p class="card-meta"><time datetime="{{ lead.date | isoDate }}">{{ lead.date | readableDate }}</time><span>{{ lead.content | readingTime }} min read</span></p>
      <h2><a href="{{ lead.url }}">{{ lead.data.title }}</a></h2>
      <p>{{ lead.data.description }}</p>
      <a class="feature-go" href="{{ lead.url }}" tabindex="-1" aria-hidden="true">Read the article <span class="feature-arrow">→</span></a>
    </div>
  </article>
  {% endif %}

  {% set rest = collections.articles.slice(1) %}
  {% if rest.length %}
  <h2 class="sr-only">More articles</h2>
  <ul class="article-grid">
    {% for item in rest %}
      <li class="article-card" data-value="{{ item.data.topic | slugify }}" data-search="{{ item.data.title }} {{ item.data.description }} {{ item.data.topic }} {{ (item.data.keywords or []) | join(' ') }}">
        <div class="article-media">{% set d = item.data %}{% set decor = true %}{% include "media.njk" %}</div>
        <p class="card-meta"><time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time><span>{{ item.content | readingTime }} min read</span></p>
        <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
        <p>{{ item.data.description }}</p>
      </li>
    {% endfor %}
  </ul>
  {% endif %}
  <div class="list-empty" id="essays-empty" hidden>
    <p>No essays match that yet.</p>
    <button type="button" class="chip">Show all essays</button>
  </div>

  <section class="pubs" aria-labelledby="pubs-title">
    <div class="section-head">
      <h2 id="pubs-title">Published research</h2>
      <a class="more" href="/cv/#publications">Full citations →</a>
    </div>
    {% set pubs = cv.publications %}{% include "publication-list.njk" %}
  </section>
</div>
