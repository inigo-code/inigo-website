{% from "icons.njk" import icon %}<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- Search results show about 60 characters: `seoTitle` is a shorter title for <title> only; the name suffix shrinks or drops to fit. -#}
  {% set fullTitle = (title + " · " + site.fullName) if title else (site.fullName + " · " + site.role + ", " + (site.institution | replace(" (Autonomous), Tiruchirappalli", ""))) %}
  {% set shortTitle = seoTitle or title %}
  {% if not title %}{% set pageTitle = fullTitle %}
  {% elif (shortTitle + " · " + site.fullName).length <= 60 %}{% set pageTitle = shortTitle + " · " + site.fullName %}
  {% elif (shortTitle + " · " + site.name).length <= 60 %}{% set pageTitle = shortTitle + " · " + site.name %}
  {% else %}{% set pageTitle = shortTitle %}{% endif %}
  {% set pageDescription = description or site.description %}
  <title>{{ pageTitle | text | safe }}</title>
  <meta name="description" content="{{ pageDescription | text | safe }}">
  <meta property="og:title" content="{{ fullTitle | text | safe }}">
  <meta property="og:description" content="{{ pageDescription | text | safe }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/entry.njk' else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% set card = page | ogCard(layout, image or site.photo) %}
  <meta property="og:image" content="{{ site.url }}{{ card.url }}">
  {% if card.width %}<meta property="og:image:width" content="{{ card.width }}">
  <meta property="og:image:height" content="{{ card.height }}">
  <meta property="og:image:type" content="image/jpeg">{% endif %}
  <meta property="og:image:alt" content="{{ (title if card.entry else site.formalName + ', ' + site.role + ' of ' + site.subject + ', ' + site.institution) | text | safe }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle | text | safe }}">
  <meta name="twitter:description" content="{{ pageDescription | text | safe }}">
  <meta name="twitter:image" content="{{ site.url }}{{ card.url }}">
  <meta name="author" content="{{ site.formalName }}">
  <meta property="og:site_name" content="{{ site.fullName }}">
  <meta property="og:locale" content="en_IN">
  {% if layout == 'layouts/entry.njk' %}<meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:author" content="{{ site.url }}/about/">{% endif %}
  {% if keywords %}<meta name="keywords" content="{{ keywords | join(', ') }}">{% endif %}
  <meta name="robots" content="{{ 'noindex' if noindex else 'index, follow, max-image-preview:large, max-snippet:-1' }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.fullName }}: articles and study notes" href="/feed.xml">
  <link rel="author" href="/about/">
  {% schema %}
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#0d2a1c" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#071a10" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500..700&family=Red+Hat+Display:wght@400..900&family=Red+Hat+Text:wght@400..600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
  <script>document.documentElement.classList.add("js"); if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) requestAnimationFrame(() => document.documentElement.classList.add("reveal-on"));</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="wordmark" href="/" translate="no" aria-label="{{ site.fullName }}, home">{% include "logo.svg" %}</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" class="nav" aria-label="Main">
        {% set navItems = [
          ["/", "Home"],
          ["/about/", "About"],
          ["/cv/", "CV"],
          ["/articles/", "Articles"],
          ["/resources/", "Resources"],
          ["/community/", "Community"],
          ["/press/", "In the news"],
          ["/contact/", "Contact"]
        ] %}
        {% for item in navItems %}
          <a href="{{ item[0] }}"{% if (item[0] == "/" and page.url == "/") or (item[0] != "/" and page.url.startsWith(item[0])) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div>
        <p class="footer-name" translate="no"><span class="footer-mark"><img class="logo" src="/assets/brand/logo-on-dark.svg" alt="" width="120" height="120" loading="lazy" decoding="async"></span><span class="footer-script"><img class="name-script" src="/assets/brand/name-script-on-dark.svg" alt="" width="748" height="118" loading="lazy" decoding="async"><span class="sr-only">{{ site.fullName }}</span></span></p>
        <p class="muted">{{ site.role }}<br>{{ site.department }}<br>{{ site.institution }}</p>
        <p class="footer-email"><a href="mailto:{{ site.personalEmail }}">{{ site.personalEmail }}</a></p>
      </div>
      <div>
        <p class="footer-label">Read</p>
        <ul class="footer-links">
          <li><a href="/articles/">Articles</a></li>
          <li><a href="/resources/">Resources</a></li>
          <li><a href="/press/">In the news</a></li>
          <li><a href="/feed.xml">Feed</a></li>
        </ul>
      </div>
      {% set brandLinks = site.seyalyst.socials | filled %}
      {% if brandLinks.length %}
      <div>
        <p class="footer-label">{{ site.seyalyst.name }}</p>
        <ul class="footer-links">
          {% for s in brandLinks %}<li><a class="with-icon" href="{{ s.url }}" rel="me noopener">{{ icon(s.label) }}{{ s.label }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endif %}
      <div>
        <p class="footer-label">Elsewhere</p>
        <ul class="footer-links">
          {% for s in site.academicLinks | filled %}<li><a class="with-icon" href="{{ s.url }}" rel="me noopener">{{ icon(s.label) }}{{ s.label }}</a></li>{% endfor %}
          <li><a class="footer-heart with-icon" href="{{ site.heartApps.url }}" rel="noopener"><img src="{{ site.heartApps.logo }}" alt="" width="20" height="20">Heart Apps</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer-base muted">© {{ build.year }} {{ site.fullName }}</div>
  </footer>

  <dialog class="lightbox" aria-label="Photo viewer">
    <div class="lb-bar">
      <button type="button" class="lb-back" data-lb-close>← Back to the page</button>
      <span class="lb-count" aria-live="polite"></span>
      <button type="button" class="lb-x" data-lb-close aria-label="Close the photo">×</button>
    </div>
    <figure class="lb-stage"><img alt=""></figure>
    <button type="button" class="lb-nav lb-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lb-nav lb-next" aria-label="Next photo">›</button>
  </dialog>

  <script>
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.getElementById("nav");
    const setMenu = (open) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
      nav.classList.toggle("open", open);
    };
    toggle.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("open")) { setMenu(false); toggle.focus(); }
    });

    const calm = matchMedia("(prefers-reduced-motion: reduce)");

    // "On this page" starts folded on a phone. Printing opens every answer, then puts the page back.
    if (matchMedia("(max-width: 720px)").matches) document.querySelectorAll(".toc details").forEach((d) => (d.open = false));
    let shut = [];
    addEventListener("beforeprint", () => { shut = [...document.querySelectorAll(".faq details:not([open])")]; shut.forEach((d) => (d.open = true)); });
    addEventListener("afterprint", () => { shut.forEach((d) => (d.open = false)); shut = []; });

    // Sections and cards rise in once as they come into view, siblings a beat apart.
    // The class comes off when the rise ends, so hover motion keeps its own quick timing.
    if ("IntersectionObserver" in window && !calm.matches) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
      }, { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".reveal, .clipping, .rail-item, .role-list li, .course-rows li").forEach((el) => io.observe(el));
      const groups = ".cards > li, .note-grid > li, .article-grid > *, .scan-grid > li, .pub-cites > li, .talk-cards > li, .stage-talks > li, .principles > li, .about-trio li, .heart-apps > li, .facts-grid > div, .campaign-grid > li, .big-stats-row > li, .contact-grid > section, .entry-list > li, .timeline > li";
      const blocks = ".section-head, .about-story, .about-stage, .about-teaching, .about-facts, .about-photo-row, .heart-intro, .contact-map, .contact-invite, .tool-feature, .article-lead, .wide-photo, .photo-pair, .cv-block, .scans, .notes-section > .section-head";
      document.querySelectorAll(groups + ", " + blocks).forEach((el) => {
        if (el.getBoundingClientRect().top < innerHeight * 0.9) return;   // already on screen: leave it be
        if (el.parentElement && el.parentElement.closest(".rv")) return; // its section already rises
        const i = el.parentElement ? [...el.parentElement.children].indexOf(el) % 4 : 0;
        el.style.setProperty("--d", (el.matches(groups) ? i * 70 : 0) + "ms");
        el.classList.add("rv");
        const done = (e) => {
          if (e.target !== el || e.propertyName !== "opacity") return;
          el.classList.remove("rv", "in"); el.style.removeProperty("--d"); el.removeEventListener("transitionend", done);
        };
        el.addEventListener("transitionend", done);
        io.observe(el);
      });
    }

    // Main nav: one soft pill slides to whichever link the pointer or keyboard is on.
    (() => {
      const pill = document.createElement("span");
      pill.className = "nav-pill"; pill.setAttribute("aria-hidden", "true");
      nav.prepend(pill);
      const go = (a) => {
        if (nav.classList.contains("open") || matchMedia("(max-width: 1080px)").matches) return;
        if (a.getAttribute("aria-current")) { pill.classList.remove("on"); return; }
        if (!pill.classList.contains("on")) { pill.style.transition = "none"; requestAnimationFrame(() => (pill.style.transition = "")); }
        pill.style.width = a.offsetWidth + "px";
        pill.style.transform = `translateX(${a.offsetLeft}px)`;
        pill.classList.add("on");
      };
      nav.querySelectorAll("a").forEach((a) => { a.addEventListener("pointerenter", () => go(a)); a.addEventListener("focus", () => go(a)); });
      nav.addEventListener("pointerleave", () => pill.classList.remove("on"));
      nav.addEventListener("focusout", (e) => { if (!nav.contains(e.relatedTarget)) pill.classList.remove("on"); });
    })();

    // Photo viewer: links to a photo open it here, over the page, with a back button.
    // The browser's own back button closes it too.
    (() => {
      const box = document.querySelector(".lightbox");
      if (!box || !box.showModal) return;
      const img = box.querySelector(".lb-stage img"), count = box.querySelector(".lb-count");
      const isPhoto = (a) => /\.(webp|jpe?g|png)$/i.test(a.getAttribute("href") || "") && a.querySelector("img");
      let set = [], at = 0, pushed = false;
      const show = (i) => {
        at = (i + set.length) % set.length;
        const a = set[at], t = a.querySelector("img");
        img.src = a.href; img.alt = t.alt || "";
        count.textContent = set.length > 1 ? `${at + 1} of ${set.length}` : "";
        box.classList.toggle("single", set.length < 2);
      };
      const close = () => { if (pushed) { pushed = false; history.back(); } else if (box.open) box.close(); };
      document.addEventListener("click", (e) => {
        const a = e.target.closest("a");
        if (!a || !isPhoto(a) || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        const scope = a.closest("ul, ol, section, main") || document;
        set = [...scope.querySelectorAll("a")].filter(isPhoto);
        show(set.indexOf(a));
        box.showModal();
        history.pushState({ lightbox: true }, ""); pushed = true;
      });
      addEventListener("popstate", () => { pushed = false; if (box.open) box.close(); });
      box.addEventListener("cancel", (e) => { e.preventDefault(); close(); });
      box.querySelectorAll("[data-lb-close]").forEach((b) => b.addEventListener("click", close));
      box.addEventListener("click", (e) => { if (e.target === box || e.target.classList.contains("lb-stage")) close(); });
      box.querySelector(".lb-prev").addEventListener("click", () => show(at - 1));
      box.querySelector(".lb-next").addEventListener("click", () => show(at + 1));
      box.addEventListener("keydown", (e) => { if (e.key === "ArrowLeft") show(at - 1); if (e.key === "ArrowRight") show(at + 1); });
    })();
  </script>
</body>
</html>
